#!/bin/bash
source "$(dirname "$0")/_common"
case $BLOCK_BUTTON in
    1) setsid pavucontrol >/dev/null 2>&1 & ;;
    3) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    4) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
esac

out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || exit 0
vol=$(awk '{printf "%d", $2*100}' <<< "$out")

if [[ $out == *MUTED* ]]; then
    emit "$G_MUTE" "$(printf '%3d%%' "$vol")" "$WARNING"
else
    emit "$G_VOL" "$(printf '%3d%%' "$vol")"
fi
