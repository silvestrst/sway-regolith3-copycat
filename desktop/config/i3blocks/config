# i3blocks driving swaybar, replicating the Regolith i3xrocks widget set.
# Block order here is left-to-right in the status area.

command=$HOME/.config/i3blocks/blocks/$BLOCK_NAME
markup=pango
separator=false
separator_block_width=22

[media]
interval=2

[notifications]
interval=2

[disk]
interval=60

[memory]
interval=5

[cpu]
interval=2

[temperature]
interval=5

[network]
interval=2

[volume]
interval=1
signal=10

[battery]
interval=15

[keyboard]
interval=5

[time]
interval=5

[help]
interval=once
