#!/usr/bin/env python3
"""Jump to the lowest-numbered unused workspace.

A stand-in for Regolith's `childe`.
  --move-window   move the focused container there
  --follow        also switch to it (used together with --move-window)
"""
import json
import subprocess
import sys


def swaymsg(*args):
    return subprocess.run(["swaymsg", *args], capture_output=True, text=True, check=True).stdout


def main():
    argv = sys.argv[1:]
    move = "--move-window" in argv
    follow = "--follow" in argv or not move

    workspaces = json.loads(swaymsg("-t", "get_workspaces"))
    used = {ws["num"] for ws in workspaces if ws.get("num", -1) > 0}

    target = next(n for n in range(1, 100) if n not in used)

    if move:
        swaymsg("move", "container", "to", "workspace", "number", str(target))
    if follow:
        swaymsg("workspace", "number", str(target))


if __name__ == "__main__":
    main()
